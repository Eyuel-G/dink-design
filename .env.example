# Copy to .env.local. The app runs without these: planning falls back to built-in layouts,
# prices stay catalog estimates, and MySQL falls back to an in-memory store.

ANTHROPIC_API_KEY=
DATABASE_URL=mysql://dink:password@127.0.0.1:3306/dink
MYSQL_URL=mysql://dink:password@127.0.0.1:3306/dink
MESHY_API_KEY=
TRIPO_API_KEY=
BROWSERLESS_TOKEN=
FIRECRAWL_API_KEY=
SKETCHFAB_TOKEN=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_KEY=
STORAGE_SECRET=
DAILY_SPEND_LIMIT_USD=5
RATE_LIMIT_PER_MIN=20
USD_ETB_RATE=150
